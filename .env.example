# ── Resend (email transacional) ───────────────────────────────────────────────
# Obtém a chave em https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remetente por defeito (opcional — usa "Adler Pro <noreply@adlerrochefort.com>" se omitido)
# Requer domínio verificado no Resend (SPF + DKIM). Ver: https://resend.com/domains
EMAIL_FROM=Adler Pro <noreply@adlerrochefort.com>

# ID do template Resend para notificações de sinistro (obrigatório para envio inter-portais)
# Obtém o ID em Resend → Templates → publicar o template → copiar o Published ID
# Variáveis esperadas pelo template: TITLE, DETAIL, MESSAGE
RESEND_TEMPLATE_CLAIMS=<published-template-id>

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Admin ─────────────────────────────────────────────────────────────────────
# Segredo para endpoints administrativos (ex.: /api/send-test-email)
ADMIN_SECRET=<secret-aleatorio-forte>

# Stripe insurance premium Payment Links — server-only; never use a VITE_ prefix.
# Set credentials in the environment; do not commit actual keys.
STRIPE_SECRET_KEY=
# Test/development product (use prod_VHukIf4wWcTtbT with live production credentials):
STRIPE_INSURANCE_PREMIUM_PRODUCT_ID=prod_VHukk4H9WtEYWh
